@using System.Net.Http.Json
@using System.Text.Json
@using MudBlazor
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">

    @* CABEÇALHO DO SISTEMA: 240K SAMPLES / 32 FEATURES / 4 MODELOS ML.NET + 8 APIS DA NASA *@
    <MudPaper Class="pa-4 mb-4" Outlined="true" Elevation="1">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" md="7">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Size="Size.Large" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h5" Color="Color.Primary">
                            <b>@_profile.DisplayNamePt</b>
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Massa: <b>@($"{_totalShipMassTons:F1} t")</b> | Blindagem: <b>@($"{_radShieldingGcm2:F0} g/cm²")</b> | Centrífuga: <b>@($"{_artificialGravityG:F2}g")</b> | Potência: <b>@($"{_electricalPowerKw:F0} kWe")</b> | Bateria: <b>@($"{_batteryStorageKwh:F0} kWh")</b>
                        </MudText>
                    </div>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="5">
                <MudStack Row="true" Justify="Justify.FlexEnd" Wrap="Wrap.Wrap" Spacing="1">
                    <MudChip T="string" Color="@(_isModelLoaded ? Color.Success : Color.Warning)" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Psychology">
                        ML.NET: @_modelSourceStatus
                    </MudChip>
                    <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.AutoAwesome">
                        Combos Ativos: @_activeSynergies.Count / 4
                    </MudChip>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.WbSunny">
                        DONKI: @_latestSolarFlare (@($"{_effectiveRadiationIndex:F2}x rad"))
                    </MudChip>
                </MudStack>
            </MudItem>
        </MudGrid>

        @* SELETOR DOS 3 DESTINOS OPERACIONAIS OFICIAIS (80.000 SAMPLES CADA = 240.000 SAMPLES) *@
        <MudDivider Class="my-3" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Destinos Operacionais (80.000 samples/destino):</b></MudText>
                <MudButton Href="spacestation" Variant="@(TargetBody == "ISS" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.SpaceDashboard">
                    1. Estação Espacial (ISS — 414 km)
                </MudButton>
                <MudButton Href="moon" Variant="@(TargetBody == "Moon" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.NightlightRound">
                    2. Lua (Artemis Gateway / Polo Sul)
                </MudButton>
                <MudButton Href="mars" Variant="@(TargetBody == "Mars" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Public">
                    3. Marte (Órbita & Superfície ISRU)
                </MudButton>
            </MudStack>

            @if (_activeSynergies.Count > 0)
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (var syn in _activeSynergies)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Bolt">
                            <b>Combo: @syn.NamePt</b>
                        </MudChip>
                    }
                </MudStack>
            }
        </MudStack>
    </MudPaper>

    @* 4 CARDS PREDITIVOS DO QUAD-ENSEMBLE ML.NET (SAÚDE, AUTONOMIA, CONFIABILIDADE E YIELD/SAFE-LIMIT) *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Outlined="true" Elevation="1" Class="pa-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.caption">ML #1 — SAÚDE & SOBREVIVÊNCIA (OSDR)</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Success"><b>@($"{_predictedCrewHealthProb * 100f:F1}%") (@_selectedCrewCount/@_maxSupportedCrew Trip.)</b></MudText>
                        <MudText Typo="Typo.caption">
                            Remédios: @($"{_medicalSuppliesKg:F0} kg") | Centrífuga: @($"{_artificialGravityG:F2}g")
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Color="Color.Success" Size="Size.Large" />
                </MudStack>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Outlined="true" Elevation="1" Class="pa-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.caption">ML #2 — CAMPANHA TOTAL (240K SAMPLES)</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Info"><b>@($"{_totalCampaignDays:F1} Dias") (@($"{_totalCampaignDays / 30f:F1} m"))</b></MudText>
                        <MudText Typo="Typo.caption">
                            Ida: @($"{_profile.OutboundTransitDays:F1}d") | Destino: @($"{_maxExplorationStayDays:F0}d") | Volta: @($"{_profile.ReturnTransitDays:F1}d")
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Info" Size="Size.Large" />
                </MudStack>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Outlined="true" Elevation="1" Class="pa-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.caption">ML #3 — CONFIABILIDADE ECLSS & TRAJES</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Secondary"><b>@($"{_predictedSystemReliability * 100f:F1}%") | ECLSS @($"{_eclssSynergyIndex * 100f:F0}%")</b></MudText>
                        <MudText Typo="Typo.caption">
                            Trajes xEMU: @($"{_evaSuitDurabilityPct:F0}%") | H₂O Loop: @($"{_waterRecoveryEff * 100f:F1}%")
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Secondary" Size="Size.Large" />
                </MudStack>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Outlined="true" Elevation="1" Class="pa-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.caption">ML #4 — YIELD SABATIER & SAFE-LIMIT</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Warning"><b>Yield @($"{_predictedFuelYield * 100f:F1}%") (Piso &le; @($"{_profile.SafeReturnYieldLimit * 100f:F0}%"))</b></MudText>
                        <MudText Typo="Typo.caption">
                            Síntese: @($"{_ch4KgPerDay:F1} kg CH₄/d") | Reserva Retorno: @($"{_safeReturnFuelPercent:F1}%")
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.LocalGasStation" Color="Color.Warning" Size="Size.Large" />
                </MudStack>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* GRID PRINCIPAL: COMBINAÇÃO INTERATIVA DOS 3 DECKS (32 CARTAS) + TELEMETRIA DE 32 FEATURES À ESQUERDA | CAROUSEL À DIREITA *@
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-4" Outlined="true" Elevation="1">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6" Color="Color.Primary">
                            <MudIcon Icon="@Icons.Material.Filled.Style" Class="mr-1" Size="Size.Small" />
                            Construtor 3-Decks (32 Features ML.NET)
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshLiveNasaTelemetryAsync">
                            Sync 8 NASA APIs
                        </MudButton>
                    </MudStack>

                    <MudExpansionPanels MultiExpansion="false" Elevation="0">
                        @* DECK 1: BUILD DA NAVE-BIOMA (10 CARTAS, ESCOLHA ATÉ 5) *@
                        <MudExpansionPanel Expanded="true" Text="@($"1. Deck de Build da Nave ({_selectedShipBuildCardIds.Count}/{MaxShipBuildCards} de 10 cartas)")">
                            <MudStack Spacing="1">
                                @foreach (var card in ThreeDeckDefinitions.ShipBuildDeck)
                                {
                                    bool eq = _selectedShipBuildCardIds.Contains(card.CardId);
                                    <MudPaper Class="pa-2" Outlined="true" Elevation="0">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <div>
                                                <MudText Typo="Typo.body2" Color="@(eq ? Color.Primary : Color.Default)">
                                                    <b>[@card.CardId] @card.Name</b> (@($"+{card.DryMassTons:F1}t"))
                                                </MudText>
                                                <MudText Typo="Typo.caption">@card.SummaryPt — <i>@card.NasaSource</i></MudText>
                                            </div>
                                            <MudSwitch T="bool" Value="@eq"
                                                       ValueChanged="@((bool v) => ToggleShipBuildCard(card.CardId, v))"
                                                       Color="Color.Primary"
                                                       Disabled="@(!eq && _selectedShipBuildCardIds.Count >= MaxShipBuildCards)" />
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        </MudExpansionPanel>

                        @* DECK 2: PROPRIEDADES DO PROJETO MARSHALL ECLSS (10 CARTAS, ESCOLHA ATÉ 5) *@
                        <MudExpansionPanel Text="@($"2. Deck de Propriedades ECLSS ({_selectedEclssCardIds.Count}/{MaxEclssCards} de 10 cartas)")">
                            <MudStack Spacing="1">
                                @foreach (var card in ThreeDeckDefinitions.EclssPropertiesDeck)
                                {
                                    bool eq = _selectedEclssCardIds.Contains(card.CardId);
                                    <MudPaper Class="pa-2" Outlined="true" Elevation="0">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <div>
                                                <MudText Typo="Typo.body2" Color="@(eq ? Color.Secondary : Color.Default)">
                                                    <b>[@card.SubsystemCode] @card.Name</b> (@($"+{card.DryMassTons:F1}t"))
                                                </MudText>
                                                <MudText Typo="Typo.caption">@card.SummaryPt — <i>@card.NasaSource</i></MudText>
                                            </div>
                                            <MudSwitch T="bool" Value="@eq"
                                                       ValueChanged="@((bool v) => ToggleEclssCard(card.CardId, v))"
                                                       Color="Color.Secondary"
                                                       Disabled="@(!eq && _selectedEclssCardIds.Count >= MaxEclssCards)" />
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        </MudExpansionPanel>

                        @* DECK 3: PROPRIEDADES DO AMBIENTE E CONTRAMEDIDAS (4 CARTAS POR DESTINO) *@
                        <MudExpansionPanel Text="@($"3. {_profile.EnvironmentDeckTitlePt} ({_selectedEnvCardIds.Count}/4 cartas)")">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Warning">
                                    <b>Propriedades Ambientais & Riscos Biológicos (@_profile.ShortLabelPt):</b>
                                </MudText>
                                @foreach (var hazard in _profile.HazardsPt)
                                {
                                    <MudText Typo="Typo.caption" Class="d-block">• @hazard</MudText>
                                }
                                <MudDivider Class="my-1" />
                                @foreach (var envCard in _profile.EnvCards)
                                {
                                    bool eq = _selectedEnvCardIds.Contains(envCard.CardId);
                                    <MudPaper Class="pa-2" Outlined="true" Elevation="0">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <div>
                                                <MudText Typo="Typo.body2" Color="@(eq ? Color.Success : Color.Default)">
                                                    <b>[@envCard.CardId] @envCard.Name</b> (+@($"{envCard.CrewProtectionBonus * 100f:F0}%") Trip / +@($"{envCard.BiomeShieldingBonus * 100f:F0}%") Bioma)
                                                </MudText>
                                                <MudText Typo="Typo.caption">@envCard.EffectPt — <i>@envCard.NasaApiSource</i></MudText>
                                            </div>
                                            <MudSwitch T="bool" Value="@eq"
                                                       ValueChanged="@((bool v) => ToggleEnvCard(envCard.CardId, v))"
                                                       Color="Color.Success" />
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        </MudExpansionPanel>

                        @* PAINEL DE AUDITORIA DAS 32 VARIÁVEIS DE ENTRADA DO MODELO ML.NET *@
                        <MudExpansionPanel Text="4. Matriz de Telemetria das 32 Variáveis ML.NET">
                            <MudSimpleTable Dense="true" Hover="true" Outlined="true">
                                <tbody>
                                    <tr><td><MudText Typo="Typo.caption">OGA Geração O₂ / CDRA Remoção CO₂</MudText></td><td class="text-end"><MudText Typo="Typo.caption"><b>@($"{_ogaCapacityKgDay:F1} kg/d") / @($"{_cdraCapacityKgDay:F1} kg/d")</b></MudText></td></tr>
                                    <tr><td><MudText Typo="Typo.caption">WPA Água / BPA Salmoura</MudText></td><td class="text-end"><MudText Typo="Typo.caption"><b>@($"{_waterRecoveryEff * 100f:F1}%") / @($"{_brineRecoveryEff * 100f:F1}%")</b></MudText></td></tr>
                                    <tr><td><MudText Typo="Typo.caption">Blindagem BNNT / Camadas Whipple</MudText></td><td class="text-end"><MudText Typo="Typo.caption"><b>@($"{_radShieldingGcm2:F0} g/cm²") / @_whippleLayers camadas</b></MudText></td></tr>
                                    <tr><td><MudText Typo="Typo.caption">Rejeição Térmica / Banco Li-S</MudText></td><td class="text-end"><MudText Typo="Typo.caption"><b>@($"{_thermalRejectionKw:F0} kWt") / @($"{_batteryStorageKwh:F0} kWh")</b></MudText></td></tr>
                                    <tr><td><MudText Typo="Typo.caption">Comida / Água / Remédios / Peças</MudText></td><td class="text-end"><MudText Typo="Typo.caption"><b>@($"{_foodProvisionsKg:F0}kg / {_potableWaterLiters:F0}L / {_medicalSuppliesKg:F0}kg / {_toolsAndSparesKg:F0}kg")</b></MudText></td></tr>
                                </tbody>
                            </MudSimpleTable>
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    <MudDivider />

                    @* AJUSTES DE TRIPULAÇÃO E SUPRIMENTOS EXTRAS *@
                    <div>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Success"><b>👨‍🚀 Número de Tripulantes na Missão</b></MudText>
                            <MudText Typo="Typo.body2"><b>@_selectedCrewCount astronautas</b></MudText>
                        </MudStack>
                        <MudSlider T="int" Value="_selectedCrewCount" ValueChanged="OnCrewCountChanged" Min="1" Max="16" Step="1" Color="Color.Success" />
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Info"><b>🍱 Mantimentos Extras: @($"+{_extraFoodKg:F0} kg")</b></MudText>
                            <MudSlider T="float" Value="_extraFoodKg" ValueChanged="OnExtraFoodChanged" Min="0f" Max="3000f" Step="200f" Color="Color.Info" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary"><b>💊 Remédios Extras: @($"+{_extraMedsKg:F0} kg")</b></MudText>
                            <MudSlider T="float" Value="_extraMedsKg" ValueChanged="OnExtraMedsChanged" Min="0f" Max="250f" Step="25f" Color="Color.Secondary" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                        @for (int i = 0; i < _scenarios.Count; i++)
                        {
                            int index = i;
                            var sc = _scenarios[index];
                            <MudButton Size="Size.Small"
                                       Variant="@(_selectedCarouselIndex == index ? Variant.Filled : Variant.Outlined)"
                                       Color="@sc.BadgeColor"
                                       OnClick="@(() => _selectedCarouselIndex = index)">
                                @(index + 1). @sc.ShortTabTitle
                            </MudButton>
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        @* CAROUSEL DE MUDTIMELINES (SLIDE 0 = 9 ESTÁGIOS COMPLETOS; SLIDES 1..3 = FALHAS) *@
        <MudItem xs="12" lg="7">
            @{
                var activeScenario = _scenarios.ElementAtOrDefault(_selectedCarouselIndex);
            }
            <MudPaper Class="pa-4" Outlined="true" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <div>
                        <MudText Typo="Typo.h6" Color="Color.Primary">
                            <b>🛰 Carousel de Timelines: Terra ➔ @_profile.ShortLabelPt ➔ Terra (9 Estágios)</b>
                        </MudText>
                        <MudText Typo="Typo.caption">
                            Slide 1 exibe a viagem bem-sucedida desde a Decolagem e Saída da Atmosfera até o Retorno pelo Safe Rate-Limit; Slides 2 a 4 simulam falhas.
                        </MudText>
                    </div>
                    <MudChip T="string" Color="@(activeScenario?.BadgeColor ?? Color.Primary)" Variant="Variant.Filled">
                        Slide @(_selectedCarouselIndex + 1) de @Math.Max(1, _scenarios.Count)
                    </MudChip>
                </MudStack>

                <MudCarousel Class="mud-width-full"
                             Style="height: 920px;"
                             ShowArrows="true"
                             ShowBullets="true"
                             EnableSwipeGesture="true"
                             AutoCycle="false"
                             TData="object"
                             @bind-SelectedIndex="_selectedCarouselIndex">

                    @foreach (var scenario in _scenarios)
                    {
                        <MudCarouselItem Transition="Transition.Slide" Color="@scenario.BadgeColor">
                            <div class="d-flex flex-column mud-height-full pa-2 pb-10">
                                <MudPaper Class="pa-3 mb-3 flex-shrink-0" Outlined="true" Elevation="0">
                                    <MudGrid AlignItems="AlignItems.Center">
                                        <MudItem xs="12" md="8">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="@scenario.HeaderIcon" Color="@scenario.BadgeColor" Size="Size.Medium" />
                                                <MudText Typo="Typo.subtitle1" Color="@scenario.BadgeColor">
                                                    <b>@scenario.Title</b>
                                                </MudText>
                                            </MudStack>
                                            <MudText Typo="Typo.body2" Class="mt-1">
                                                @scenario.Subtitle
                                            </MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudStack Spacing="1" AlignItems="AlignItems.End">
                                                <MudChip T="string" Color="@scenario.BadgeColor" Size="Size.Small" Variant="Variant.Filled">
                                                    ⏱ Total: @($"{scenario.MaxTrajectoryDays:F1} d") (@($"{scenario.MaxTrajectoryDays / 30f:F1} meses"))
                                                </MudChip>
                                                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                                                    👨‍🚀 Tripulação: @_selectedCrewCount / @scenario.MaxCrewCapacity (@scenario.CrewSurvivalStatus)
                                                </MudChip>
                                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">
                                                    🧠 Saúde: @($"{_predictedCrewHealthProb * 100f:F1}%") | Confiab.: @($"{_predictedSystemReliability * 100f:F1}%")
                                                </MudChip>
                                            </MudStack>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>

                                <div class="flex-grow-1 overflow-y-auto pr-2">
                                    <MudTimeline TimelinePosition="TimelinePosition.Alternate" TimelineAlign="TimelineAlign.Default">
                                        @foreach (var step in scenario.Steps)
                                        {
                                            <MudTimelineItem Color="@step.DotColor" Size="Size.Medium" Variant="Variant.Filled">
                                                <ItemOpposite>
                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.subtitle2" Color="@step.DotColor">
                                                            <b>@step.MissionTimeWindow</b>
                                                        </MudText>
                                                        <MudText Typo="Typo.caption">
                                                            📍 @step.DistanceAndLocation
                                                        </MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            ♻ Reciclagem ECLSS: @($"{step.RecyclingRatePercent:F1}%")
                                                        </MudText>
                                                    </MudStack>
                                                </ItemOpposite>
                                                <ItemContent>
                                                    <MudCard Outlined="true" Elevation="1" Class="pa-3">
                                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                                                            <MudText Typo="Typo.subtitle2" Color="@step.DotColor">
                                                                <b>@step.StageTitle</b>
                                                            </MudText>
                                                            <MudChip T="string" Color="@step.DotColor" Size="Size.Small" Variant="Variant.Outlined">
                                                                Yield ML: @($"{step.MlPredictedYieldPercent:F1}%")
                                                            </MudChip>
                                                        </MudStack>

                                                        <MudText Typo="Typo.body2" Class="mb-2">
                                                            @step.Description
                                                        </MudText>

                                                        <MudProgressLinear Color="@step.DotColor"
                                                                           Value="@step.FuelReservePercent"
                                                                           Size="Size.Small"
                                                                           Rounded="true"
                                                                           Class="my-1" />

                                                        <MudStack Row="true" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                                            <MudText Typo="Typo.caption" Color="Color.Warning">
                                                                <b>🔥 Combustível CH₄: @($"{step.FuelReservePercent:F1}%")</b>
                                                            </MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Success">
                                                                <b>👨‍🚀 @step.ActiveCrewStatus</b>
                                                            </MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Info">
                                                                <b>⚡ @step.BioTechBalanceNote</b>
                                                            </MudText>
                                                        </MudStack>
                                                    </MudCard>
                                                </ItemContent>
                                            </MudTimelineItem>
                                        }
                                    </MudTimeline>
                                </div>
                            </div>
                        </MudCarouselItem>
                    }
                </MudCarousel>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    [Parameter]
    public string TargetBody { get; set; } = "ISS";

    private const int MaxShipBuildCards = 5;
    private const int MaxEclssCards = 5;

    private string _loadedTargetKey = string.Empty;
    private DestinationProfile _profile = DestinationCatalog.GetProfile("ISS");

    private int _selectedCarouselIndex = 0;
    private bool _isModelLoaded = false;
