    protected override void OnParametersSet()
    {
        if (!string.Equals(_loadedTargetKey, TargetBody, StringComparison.OrdinalIgnoreCase))
        {
            _loadedTargetKey = TargetBody;
            _profile = DestinationCatalog.GetProfile(TargetBody);
            _selectedCrewCount = _profile.RecommendedCrew;
            _selectedEnvCardIds = _profile.EnvCards.Select(c => c.CardId).ToHashSet();
            _liveDistanceKm = _cachedLiveDistances.TryGetValue(_profile.IdKey, out var d) ? d : _profile.MeanDistanceFromEarthKm;
            _selectedCarouselIndex = 0;
            RecalculateMissionAndTimelines();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            InitializeWasmMlEvaluatorAsync(),
            LoadNasaSnapshotArtifactAsync()
        );

        _liveDistanceKm = _cachedLiveDistances.TryGetValue(_profile.IdKey, out var d) ? d : _profile.MeanDistanceFromEarthKm;
        RecalculateMissionAndTimelines();
    }

    private void ToggleShipBuildCard(string cardId, bool equip)
    {
        if (equip && _selectedShipBuildCardIds.Count < MaxShipBuildCards)
            _selectedShipBuildCardIds.Add(cardId);
        else if (!equip && _selectedShipBuildCardIds.Count > 1)
            _selectedShipBuildCardIds.Remove(cardId);
        RecalculateMissionAndTimelines();
    }

    private void ToggleEclssCard(string cardId, bool equip)
    {
        if (equip && _selectedEclssCardIds.Count < MaxEclssCards)
            _selectedEclssCardIds.Add(cardId);
        else if (!equip && _selectedEclssCardIds.Count > 1)
            _selectedEclssCardIds.Remove(cardId);
        RecalculateMissionAndTimelines();
    }

    private void ToggleEnvCard(string cardId, bool equip)
    {
        if (equip)
            _selectedEnvCardIds.Add(cardId);
        else
            _selectedEnvCardIds.Remove(cardId);
        RecalculateMissionAndTimelines();
    }

    private void ComputeThreeDeckCombinedProperties()
    {
        var shipCards = ThreeDeckDefinitions.ShipBuildDeck.Where(c => _selectedShipBuildCardIds.Contains(c.CardId)).ToList();
        var eclssCards = ThreeDeckDefinitions.EclssPropertiesDeck.Where(c => _selectedEclssCardIds.Contains(c.CardId)).ToList();
        var envCards = _profile.EnvCards.Where(c => _selectedEnvCardIds.Contains(c.CardId)).ToList();

        var allEquipped = _selectedShipBuildCardIds.Concat(_selectedEclssCardIds).Concat(_selectedEnvCardIds).ToHashSet();
        _activeSynergies = ThreeDeckDefinitions.ComboSynergies.Where(s => s.RequiredCards.All(r => allEquipped.Contains(r))).ToList();
        float comboBonus = _activeSynergies.Count * 0.045f;

        float shipDryMass = shipCards.Sum(c => c.DryMassTons);
        float eclssDryMass = eclssCards.Sum(c => c.DryMassTons);

        _bioreactorLiters = _profile.BaseBioreactorLiters + eclssCards.Sum(c => c.BioreactorVolumeLitersBonus);
        _waterRecoveryEff = Math.Clamp(0.880f + eclssCards.Sum(c => c.WaterRecoveryEfficiencyBonus) + comboBonus * 0.2f, 0.86f, 0.993f);
        _brineRecoveryEff = Math.Clamp(0.820f + eclssCards.Sum(c => c.WaterRecoveryEfficiencyBonus * 1.4f), 0.80f, 0.985f);
        _electricalPowerKw = Math.Clamp(75.0f + shipCards.Sum(c => c.ElectricalPowerKwDelta) - eclssCards.Sum(c => c.ElectricalPowerKwDraw), 35.0f, 260.0f);
        _batteryStorageKwh = 120f + shipCards.Sum(c => c.BatteryStorageKwhBonus);
        _thermalRejectionKw = 65f + shipCards.Sum(c => c.ThermalRejectionCapacityKw);
        _radShieldingGcm2 = 8.0f + shipCards.Sum(c => c.RadiationShieldingGcm2);
        _whippleLayers = 2 + shipCards.Sum(c => c.MicrometeoroidWhippleLayers);
        _artificialGravityG = shipCards.Sum(c => c.ArtificialGravityCentrifugeG);
        _foodProvisionsKg = 900f + _extraFoodKg + shipCards.Sum(c => c.FoodProvisionsKgBonus);
        _potableWaterLiters = 900f + shipCards.Sum(c => c.PotableWaterLitersBonus);
        _medicalSuppliesKg = 80f + _extraMedsKg + shipCards.Sum(c => c.MedicalSuppliesKgBonus);
        _evaSuitDurabilityPct = Math.Clamp(68f + shipCards.Sum(c => c.EvaSuitDurabilityBonusPct) + envCards.Sum(c => c.SuitPreservationBuff * 15f), 55f, 100f);
        _toolsAndSparesKg = 160f + shipCards.Sum(c => c.ToolsAndSparesKgBonus);
        _commsBandwidthGbps = 1.5f + shipCards.Sum(c => c.CommsBandwidthGbpsBonus);

        _ogaCapacityKgDay = 2.8f + eclssCards.Sum(c => c.O2GenerationEfficiencyBonus * 9.5f);
        _cdraCapacityKgDay = 3.2f + eclssCards.Sum(c => c.Co2ScrubbingEfficiencyBonus * 10.5f);

        _eclssSynergyIndex = Math.Clamp(
            ((eclssCards.Sum(c => c.O2GenerationEfficiencyBonus) +
              eclssCards.Sum(c => c.Co2ScrubbingEfficiencyBonus) +
              eclssCards.Sum(c => c.SabatierMethaneYieldBonus)) / 2.1f) + comboBonus,
            0.20f, 0.99f);

        _crewProtectionBuff = Math.Clamp(
            (shipCards.Sum(c => c.CrewProtectionBuff) + envCards.Sum(c => c.CrewProtectionBonus)) * 0.42f + comboBonus,
            0.12f, 0.97f);

        _biomeShieldingBuff = Math.Clamp(
            (eclssCards.Sum(c => c.FilterEntropyResistanceBonus) + envCards.Sum(c => c.BiomeShieldingBonus)) * 0.42f + comboBonus,
            0.12f, 0.97f);

        _totalShipMassTons = 38.0f + shipDryMass + eclssDryMass + (_bioreactorLiters / 1000f) +
                             ((_foodProvisionsKg + _potableWaterLiters + _medicalSuppliesKg + _toolsAndSparesKg) / 1000f);
    }

    private async Task InitializeWasmMlEvaluatorAsync()
    {
        try
        {
            var resp = await Http.GetAsync("MLArtifacts/bioship_fasttree_ensemble.json");
            if (resp.IsSuccessStatusCode)
            {
                var artifact = await resp.Content.ReadFromJsonAsync<QuadFastTreeArtifact>();
                if (artifact is not null &&
                    (artifact.YieldEnsemble?.Trees.Count > 0 || artifact.Trees.Count > 0))
                {
                    _quadEnsemble = artifact;
                    _isModelLoaded = true;
                    int treeCount = (artifact.YieldEnsemble?.Trees.Count ?? artifact.Trees.Count) +
                                    (artifact.DaysEnsemble?.Trees.Count ?? 0) +
                                    (artifact.HealthEnsemble?.Trees.Count ?? 0) +
                                    (artifact.ReliabilityEnsemble?.Trees.Count ?? 0);
                    _modelSourceStatus = $"240k Quad-ML ({treeCount} árvores / 32 feat)";
                    return;
                }
            }
        }
        catch { }

        _isModelLoaded = true;
        _modelSourceStatus = "240k Quad Surrogate (32 feat)";
    }

    private async Task LoadNasaSnapshotArtifactAsync()
    {
        try
        {
            var resp = await Http.GetAsync("MLArtifacts/bioship_nasa_snapshot.json");
            if (resp.IsSuccessStatusCode)
            {
                var snapshot = await resp.Content.ReadFromJsonAsync<NasaSolarSystemSnapshotDto>();
                if (snapshot is not null)
                {
                    if (!string.IsNullOrWhiteSpace(snapshot.LatestSolarFlareClass))
                        _latestSolarFlare = snapshot.LatestSolarFlareClass;
                    if (snapshot.BaseSolarWeatherMultiplier > 0)
                        _baseSolarWeatherMultiplier = snapshot.BaseSolarWeatherMultiplier;
                    if (snapshot.LiveDistancesFromEarthKm is { Count: > 0 })
                        _cachedLiveDistances = snapshot.LiveDistancesFromEarthKm;
                }
            }
        }
        catch { }
    }

    private async Task RefreshLiveNasaTelemetryAsync()
    {
        try
        {
            string endDate = DateTime.UtcNow.ToString("yyyy-MM-dd");
            string startDate = DateTime.UtcNow.AddDays(-7).ToString("yyyy-MM-dd");
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3.5));
            var resp = await Http.GetAsync($"https://api.nasa.gov/DONKI/FLR?startDate={startDate}&endDate={endDate}&api_key=DEMO_KEY", cts.Token);
            if (resp.IsSuccessStatusCode)
            {
                using var doc = await JsonDocument.ParseAsync(await resp.Content.ReadAsStreamAsync());
                if (doc.RootElement.ValueKind == JsonValueKind.Array && doc.RootElement.GetArrayLength() > 0)
                {
                    var last = doc.RootElement[doc.RootElement.GetArrayLength() - 1];
                    if (last.TryGetProperty("classType", out var cls))
                    {
                        _latestSolarFlare = cls.GetString() ?? "C2.1";
                        _baseSolarWeatherMultiplier = _latestSolarFlare.StartsWith("X") ? 1.95f
                                                    : _latestSolarFlare.StartsWith("M") ? 1.38f : 1.08f;
                    }
                }
            }
        }
        catch { }

        int dayOfYear = DateTime.UtcNow.DayOfYear;
        double angle = ((dayOfYear + _profile.OrderIndex * 37) % 365.25) / 365.25 * Math.PI * 2.0;
        double varRatio = _profile.IdKey == "ISS" ? 0.015 : (_profile.IdKey == "Moon" ? 0.055 : 0.14);
        _liveDistanceKm = Math.Round(_profile.MeanDistanceFromEarthKm * (1.0 + Math.Sin(angle) * varRatio), 1);

        RecalculateMissionAndTimelines();
    }

    public (float Yield, float StayDays, float HealthProb, float Reliability) QueryQuadMlModel(
        float biomassPct, float techPowerPct, float entropy, float effectiveRad, float crewBuff, float biomeBuff, float eclssSynergy)
    {
        float log10Dist = (float)Math.Log10(Math.Max(100.0, _liveDistanceKm));
        float[] features =
        [
            _selectedCrewCount, _bioreactorLiters, _waterRecoveryEff, _brineRecoveryEff,
            biomassPct, techPowerPct, entropy, effectiveRad, _inputThrottle, _inputTechAlloc,
            log10Dist, _profile.SolarIrradianceFactor, _profile.TotalMissionDeltaVms, _profile.SurfaceGravityMs2,
            crewBuff, biomeBuff,
            _totalShipMassTons, _foodProvisionsKg, _potableWaterLiters, _medicalSuppliesKg,
            _electricalPowerKw, _batteryStorageKwh, _thermalRejectionKw, _radShieldingGcm2,
            _whippleLayers, _artificialGravityG, _evaSuitDurabilityPct, _toolsAndSparesKg,
            _commsBandwidthGbps, _ogaCapacityKgDay, _cdraCapacityKgDay, eclssSynergy
        ];

        var phys = ComputeQuadReference(features);

        if (_quadEnsemble?.YieldEnsemble is { Trees.Count: > 0 } yTrees &&
            _quadEnsemble?.DaysEnsemble is { Trees.Count: > 0 } dTrees)
        {
            float mlYield = Math.Clamp(yTrees.Predict(features), 0.14f, 0.99f);
            float mlDays = Math.Clamp(dTrees.Predict(features), 12f, 720f);
            float mlHealth = _quadEnsemble.HealthEnsemble is { Trees.Count: > 0 } hTrees
                ? Math.Clamp(hTrees.Predict(features), 0.18f, 0.996f)
                : phys.HealthProb;
            float mlRel = _quadEnsemble.ReliabilityEnsemble is { Trees.Count: > 0 } rTrees
                ? Math.Clamp(rTrees.Predict(features), 0.20f, 0.995f)
                : phys.Reliability;
            return (mlYield, mlDays, mlHealth, mlRel);
        }

        return phys;
    }

    public static (float Yield, float StayDays, float HealthProb, float Reliability) ComputeQuadReference(float[] f)
    {
        float safeCrew = Math.Max(1f, f[0]);
        float bioLiters = f[1], waterEff = f[2], brineEff = f[3], biomass = f[4], tech = f[5], entropy = f[6], rad = f[7];
        float throttle = f[8], alloc = f[9], log10Dist = f[10], solarIrr = f[11], deltaV = f[12], surfG = f[13];
        float crewBuff = f[14], biomeBuff = f[15], massTons = f[16], foodKg = f[17], waterL = f[18], medsKg = f[19];
        float elecKw = f[20], battKwh = f[21], thermKw = f[22], radShield = f[23], whipple = f[24], artG = f[25];
        float suitPct = f[26], toolsKg = f[27], commsGbps = f[28], ogaKg = f[29], cdraKg = f[30], eclssSyn = f[31];

        float effectiveCrewStress = Math.Clamp(1.0f - (crewBuff * 0.40f), 0.48f, 1.0f);
        float o2Ratio = Math.Clamp((ogaKg + (bioLiters / 420f) * 0.84f) / (safeCrew * 0.84f), 0.35f, 3.20f);
        float co2Ratio = Math.Clamp((cdraKg + (bioLiters / 400f) * 1.04f) / (safeCrew * 1.04f), 0.35f, 3.20f);
        float gasLoopRatio = MathF.Sqrt(o2Ratio * co2Ratio);

        float requiredKw = (bioLiters / 1000f) * 14.5f + (safeCrew * 3.4f) + (eclssSyn * 16.0f);
        float electricalRatio = Math.Clamp((elecKw + battKwh * 0.04f) / Math.Max(15f, requiredKw), 0.45f, 1.38f);
        float thermalRatio = Math.Clamp(thermKw / Math.Max(40f, requiredKw * 0.85f), 0.55f, 1.25f);
        float massEff = Math.Clamp(112.0f / Math.Max(45.0f, massTons), 0.65f, 1.25f);

        float naturalLight = Math.Clamp(MathF.Sqrt(Math.Min(1.5f, solarIrr)) * 0.10f, 0.02f, 0.14f);
        float bnnAtten = Math.Clamp(radShield / 42.0f, 0.05f, 0.65f);
        float radPenalty = Math.Max(0f, (rad - 0.80f) * 0.075f * (1.0f - biomeBuff * 0.60f) * (1.0f - bnnAtten * 0.50f));

        float totalWaterLoop = Math.Clamp((waterEff * 0.75f) + (brineEff * 0.25f), 0.80f, 0.994f);
        float loopClosure = Math.Clamp((totalWaterLoop * 0.48f) + (eclssSyn * 0.26f) + ((1.0f - entropy) * 0.22f) + (biomeBuff * 0.10f) + naturalLight - radPenalty, 0.16f, 0.995f);
        float synergy = MathF.Sqrt((biomass / 100f) * (tech / 100f)) * (0.62f + 0.38f * MathF.Min(1.25f, throttle * alloc)) * MathF.Sqrt(electricalRatio * thermalRatio) * Math.Clamp(massEff, 0.78f, 1.15f);
        float yieldRate = Math.Clamp(synergy * loopClosure * Math.Clamp(gasLoopRatio, 0.55f, 1.32f), 0.14f, 0.99f);

        float envWear = Math.Clamp(1.0f + ((log10Dist - 2.6f) * 0.08f) + ((deltaV - 9800f) / 35000f), 0.80f, 1.60f);
        float toolFactor = Math.Clamp(1.0f - (toolsKg / 2500f), 0.58f, 1.0f);
        float filterProt = Math.Clamp(1.0f - (eclssSyn * 0.36f) - (biomeBuff * 0.36f), 0.35f, 1.0f);
        float crewPenalty = Math.Clamp((safeCrew * effectiveCrewStress) / Math.Max(0.5f, bioLiters / 360f), 0.14f, 2.50f);

        float dailyEntropy = ((0.0015f * crewPenalty) + (0.0019f * (1.0f - totalWaterLoop) * 10f) + (0.0010f * MathF.Max(0f, throttle - 0.75f)) + (0.0006f * rad * (1.0f - biomeBuff * 0.60f)) - (0.0008f * (alloc - 0.70f))) * envWear * filterProt * toolFactor;
        dailyEntropy = Math.Clamp(dailyEntropy, 0.0009f, 0.035f);
        float safeCeiling = Math.Clamp(0.85f - ((log10Dist - 2.6f) * 0.020f) + (crewBuff * 0.06f), 0.64f, 0.89f);
        float entropyDays = ((safeCeiling - entropy) / dailyEntropy) * Math.Clamp(gasLoopRatio, 0.50f, 2.05f);

        float algalFoodSup = Math.Clamp((bioLiters / (safeCrew * 1050f)) * 0.48f, 0.10f, 0.60f);
        float foodDays = foodKg / Math.Max(0.20f, safeCrew * 0.62f * (1.0f - algalFoodSup));
        float waterDays = waterL / Math.Max(0.10f, safeCrew * 3.54f * Math.Max(0.008f, 1.0f - totalWaterLoop));
        float medDays = (medsKg / Math.Max(0.018f, safeCrew * 0.040f * Math.Max(0.50f, rad * (1.0f - crewBuff * 0.55f)))) * (1.0f + Math.Min(0.25f, commsGbps * 0.012f));
        float suitDays = Math.Max(15f, (suitPct - 25.0f) / Math.Max(0.065f, (0.15f + log10Dist * 0.032f) * (1.0f - crewBuff * 0.45f) * toolFactor));

        float logDays = Math.Min(Math.Min(foodDays, waterDays), Math.Min(medDays, suitDays));
        float stayDays = Math.Clamp(((entropyDays * 0.55f) + (Math.Min(entropyDays * 1.35f, logDays) * 0.45f)) * massEff, 12f, 720f);

        float gravHealth = Math.Clamp((surfG / 9.81f) + artG + 0.35f, 0.35f, 1.0f);
        float medRatio = Math.Clamp(medsKg / (safeCrew * 35f), 0.30f, 1.25f);
        float healthProb = Math.Clamp(0.52f + (crewBuff * 0.22f) + (bnnAtten * 0.14f) + (gravHealth * 0.10f) + (Math.Min(1.0f, medRatio) * 0.08f) - (radPenalty * 0.65f) - (entropy * 0.12f), 0.18f, 0.996f);

        float whippleFactor = Math.Clamp(whipple / 6.0f, 0.15f, 1.0f);
        float reliability = Math.Clamp(0.45f + (eclssSyn * 0.20f) + ((suitPct / 100f) * 0.16f) + ((1.0f - toolFactor) * 0.22f) + (whippleFactor * 0.08f) + (Math.Min(1.0f, thermalRatio) * 0.08f) - (entropy * 0.18f), 0.20f, 0.995f);

        return (yieldRate, stayDays, healthProb, reliability);
    }

    private void OnCrewCountChanged(int val) { _selectedCrewCount = val; RecalculateMissionAndTimelines(); }
    private void OnExtraFoodChanged(float val) { _extraFoodKg = val; RecalculateMissionAndTimelines(); }
    private void OnExtraMedsChanged(float val) { _extraMedsKg = val; RecalculateMissionAndTimelines(); }

    private void RecalculateMissionAndTimelines()
    {
        ComputeThreeDeckCombinedProperties();

        var initialQuad = QueryQuadMlModel(_inputBiomass, _inputTechPower, _inputInitialEntropy, _effectiveRadiationIndex, _crewProtectionBuff, _biomeShieldingBuff, _eclssSynergyIndex);
        _predictedFuelYield = initialQuad.Yield;
        _maxExplorationStayDays = initialQuad.StayDays;
        _predictedCrewHealthProb = initialQuad.HealthProb;
        _predictedSystemReliability = initialQuad.Reliability;

        _crewO2KgPerDay = _selectedCrewCount * 0.84f;
        _algalO2ProducedKgPerDay = _ogaCapacityKgDay + ((_bioreactorLiters / 420f) * 0.84f * (_inputBiomass / 100f));
        _maxSupportedCrew = Math.Clamp((int)Math.Floor(_algalO2ProducedKgPerDay / (0.84f * (1.0f - _crewProtectionBuff * 0.20f))), 1, 24);
        _ch4KgPerDay = 15.0f + (_predictedFuelYield * 30.0f * _inputThrottle);
        _safeReturnFuelPercent = Math.Clamp(_profile.SafeReturnFuelReserveFloor + (_profile.TotalMissionDeltaVms / 2200f) + (_totalShipMassTons / 25f), 18.0f, 52.0f);

        var cruiseQuad = QueryQuadMlModel(_inputBiomass * 0.94f, _inputTechPower * 0.93f, _inputInitialEntropy + 0.12f, _effectiveRadiationIndex, _crewProtectionBuff, _biomeShieldingBuff, _eclssSynergyIndex);
        var arrivalQuad = QueryQuadMlModel(_inputBiomass * 0.88f, _inputTechPower * 0.88f, _inputInitialEntropy + 0.24f, _effectiveRadiationIndex, _crewProtectionBuff, _biomeShieldingBuff, _eclssSynergyIndex);
        var safeLimitQuad = QueryQuadMlModel(_inputBiomass * 0.74f, _inputTechPower * 0.76f, 0.68f, _effectiveRadiationIndex, _crewProtectionBuff, _biomeShieldingBuff, _eclssSynergyIndex);
        var eclssFailureQuad = QueryQuadMlModel(_inputBiomass * 0.65f, _inputTechPower * 0.70f, _inputInitialEntropy + 0.25f, _effectiveRadiationIndex, 0.10f, 0.10f, 0.25f);
        var solarStormQuad = QueryQuadMlModel(_inputBiomass * 0.52f, _inputTechPower * 0.50f, 0.76f, _effectiveRadiationIndex * 1.95f, _crewProtectionBuff * 0.5f, _biomeShieldingBuff * 0.5f, _eclssSynergyIndex * 0.7f);

        float outboundDays = _profile.OutboundTransitDays;
        float returnDays = _profile.ReturnTransitDays;
        float tArrival = outboundDays;
        float tSafeLimitTrigger = outboundDays + _maxExplorationStayDays;
        float tReturnMid = tSafeLimitTrigger + (returnDays * 0.65f);
        float tLanding = _totalCampaignDays;

        _scenarios = new List<TrajectoryScenario>
        {
            new TrajectoryScenario
            {
                ShortTabTitle = $"1. Viagem Bem-Sucedida ({_totalCampaignDays:F0}d)",
                Title = $"Missão Nominal Terra ➔ {_profile.ShortLabelPt} ➔ Terra ({_totalCampaignDays:F1} Dias / {_activeSynergies.Count} Combos Ativos)",
                Subtitle = $"Combinando {_selectedShipBuildCardIds.Count} cartas de Nave ({_totalShipMassTons:F1}t, {_radShieldingGcm2:F0} g/cm² BNNT), {_selectedEclssCardIds.Count} cartas Marshall ECLSS ({_eclssSynergyIndex * 100f:F0}%) e {_selectedEnvCardIds.Count} cartas de Ambiente ({_profile.ShortLabelPt}).",
                BadgeColor = Color.Success,
                HeaderIcon = Icons.Material.Filled.CheckCircle,
