@page "/not-found"
@layout MainLayout
@inject ILocalizer<NotFound> L

<PageTitle>@L["NotFound"]</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">404 - @L["NotFound"]</MudText>
<MudText Class="mb-8">@L["NotFoundDescription"]</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">@L["GoHome"]</MudButton>
